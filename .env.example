PORT=3000

# Supabase Dashboard > Connect > Session pooler (works on IPv4 networks).
# Username must be postgres.PROJECT_REF. Replace the password placeholder.
# If the password has special characters (@ : / ? # %), URL-encode them (@ -> %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Optional alternative to DATABASE_URL (use these if the URL gives you trouble):
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.PROJECT_REF
# DB_PASSWORD=

# Optional. Default is an encrypted connection without certificate verification.
# For strict verification, download Supabase's CA certificate and point to it:
# DATABASE_CA=certs/supabase-ca.crt
# Set to "disable" only for a local, non-Supabase Postgres:
# DB_SSL=disable
# DB_POOL_MAX=5

# Generate strong random values; do not commit the real .env file.
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY: same command (exactly 64 hex characters)
JWT_SECRET=
ENCRYPTION_KEY=
